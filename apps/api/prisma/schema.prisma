generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["identity", "crm", "membership", "operations", "platform", "audit"]
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("organization_status")
  @@schema("identity")
}

enum BranchStatus {
  ACTIVE
  DEACTIVATED

  @@map("branch_status")
  @@schema("identity")
}

enum StaffRole {
  SUPER_ADMIN
  GYM_ADMIN
  EMPLOYEE

  @@map("staff_role")
  @@schema("identity")
}

enum StaffStatus {
  INVITED
  ACTIVE
  DEACTIVATED
  LOCKED

  @@map("staff_status")
  @@schema("identity")
}

enum AuditActorType {
  STAFF_USER
  CLIENT_ACCOUNT
  SYSTEM

  @@map("audit_actor_type")
  @@schema("audit")
}

model Organization {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String             @db.VarChar(40)
  name                 String             @db.VarChar(160)
  legalName            String?            @map("legal_name") @db.VarChar(200)
  status               OrganizationStatus @default(ACTIVE)
  defaultTimezone      String             @default("Europe/Kyiv") @map("default_timezone") @db.VarChar(64)
  deactivationReason   String?            @map("deactivation_reason") @db.VarChar(500)
  deactivatedAt        DateTime?          @map("deactivated_at") @db.Timestamptz
  createdByStaffUserId String?            @map("created_by_staff_user_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  version              Int                @default(1)

  branches   Branch[]
  staffUsers StaffUser[]

  @@unique([id, code])
  @@map("organizations")
  @@schema("identity")
}

model Branch {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String       @map("organization_id") @db.Uuid
  code                  String       @db.VarChar(40)
  name                  String       @db.VarChar(160)
  addressLine1          String?      @map("address_line_1") @db.VarChar(200)
  addressLine2          String?      @map("address_line_2") @db.VarChar(200)
  city                  String?      @db.VarChar(120)
  timezone              String       @db.VarChar(64)
  status                BranchStatus @default(ACTIVE)
  autoCloseAfterMinutes Int?         @map("auto_close_after_minutes")
  deactivationReason    String?      @map("deactivation_reason") @db.VarChar(500)
  deactivatedAt         DateTime?    @map("deactivated_at") @db.Timestamptz
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  version               Int          @default(1)

  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branchAssignments StaffBranchAssignment[]

  @@unique([id, organizationId])
  @@map("branches")
  @@schema("identity")
}

model StaffUser {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String?     @map("organization_id") @db.Uuid
  email                String      @db.VarChar(254)
  emailNormalized      String      @map("email_normalized") @db.VarChar(254)
  passwordHash         String      @map("password_hash") @db.VarChar(255)
  firstName            String      @map("first_name") @db.VarChar(100)
  lastName             String      @map("last_name") @db.VarChar(100)
  phone                String?     @db.VarChar(32)
  phoneNormalized      String?     @map("phone_normalized") @db.VarChar(32)
  role                 StaffRole
  status               StaffStatus @default(INVITED)
  failedLoginCount     Int         @default(0) @map("failed_login_count")
  lockedUntil          DateTime?   @map("locked_until") @db.Timestamptz
  lastLoginAt          DateTime?   @map("last_login_at") @db.Timestamptz
  passwordChangedAt    DateTime?   @map("password_changed_at") @db.Timestamptz
  deactivatedAt        DateTime?   @map("deactivated_at") @db.Timestamptz
  createdByStaffUserId String?     @map("created_by_staff_user_id") @db.Uuid
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  version              Int         @default(1)

  organization      Organization?           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branchAssignments StaffBranchAssignment[] @relation("StaffUserAssignments")
  assignedBy         StaffBranchAssignment[] @relation("StaffAssignmentActor")
  revokedBy          StaffBranchAssignment[] @relation("StaffRevocationActor")
  refreshTokens      RefreshToken[]

  @@unique([emailNormalized])
  @@unique([id, organizationId])
  @@map("staff_users")
  @@schema("identity")
}

model StaffBranchAssignment {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  staffUserId           String    @map("staff_user_id") @db.Uuid
  branchId              String    @map("branch_id") @db.Uuid
  isPrimary             Boolean   @default(false) @map("is_primary")
  assignedByStaffUserId String?   @map("assigned_by_staff_user_id") @db.Uuid
  assignedAt            DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  revokedByStaffUserId  String?   @map("revoked_by_staff_user_id") @db.Uuid
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz

  staffUser StaffUser  @relation("StaffUserAssignments", fields: [staffUserId], references: [id], onDelete: Restrict)
  branch    Branch     @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assignedBy StaffUser? @relation("StaffAssignmentActor", fields: [assignedByStaffUserId], references: [id], onDelete: Restrict)
  revokedBy  StaffUser? @relation("StaffRevocationActor", fields: [revokedByStaffUserId], references: [id], onDelete: Restrict)

  @@map("staff_branch_assignments")
  @@schema("identity")
}

model RefreshToken {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffUserId       String?   @map("staff_user_id") @db.Uuid
  clientAccountId   String?   @map("client_account_id") @db.Uuid
  tokenHash         String    @map("token_hash") @db.VarChar(255)
  familyId          String    @default(dbgenerated("gen_random_uuid()")) @map("family_id") @db.Uuid
  issuedAt          DateTime  @default(now()) @map("issued_at") @db.Timestamptz
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz
  revokeReason      String?   @map("revoke_reason") @db.VarChar(120)
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  ipHash            String?   @map("ip_hash") @db.VarChar(128)
  userAgent         String?   @map("user_agent") @db.VarChar(500)

  staffUser       StaffUser?    @relation(fields: [staffUserId], references: [id], onDelete: Restrict)
  replacedByToken RefreshToken? @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: Restrict)
  replacedTokens  RefreshToken[] @relation("RefreshTokenRotation")

  @@unique([tokenHash])
  @@map("refresh_tokens")
  @@schema("identity")
}

model AuditLog {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String?        @map("organization_id") @db.Uuid
  branchId             String?        @map("branch_id") @db.Uuid
  actorType            AuditActorType @default(STAFF_USER) @map("actor_type")
  actorStaffUserId     String?        @map("actor_staff_user_id") @db.Uuid
  actorClientAccountId String?        @map("actor_client_account_id") @db.Uuid
  actorRole            String?        @map("actor_role") @db.VarChar(50)
  action               String         @db.VarChar(120)
  entityType           String         @map("entity_type") @db.VarChar(80)
  entityId             String?        @map("entity_id") @db.Uuid
  oldValues            Json?          @map("old_values") @db.JsonB
  newValues            Json?          @map("new_values") @db.JsonB
  reason               String?        @db.VarChar(1000)
  correlationId        String         @map("correlation_id") @db.Uuid
  requestId            String?        @map("request_id") @db.VarChar(120)
  ipHash               String?        @map("ip_hash") @db.VarChar(128)
  userAgent            String?        @map("user_agent") @db.VarChar(500)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@map("audit_logs")
  @@schema("audit")
}
